<!DOCTYPE html>
<html>
	<head>
		<title>Movie App</title>
		<% include head %>
	</head>
	<body>
		<% include navbar %>

		<div class="container">
			<div class="row">
				<div class="col-sm-12">
					<h1>OMDB Movies</h1>
				</div>
				<div class="col-sm-12">
					<% if (typeof parsedData !== 'undefined' && Array.isArray(parsedData)) { %>
						<% parsedData.forEach((movie)=>{ %>
							<div class="col-md-3 col-sm-4 poster">
								<a href="/movie/<%= movie.imdbID %>">
									<img src="<%= movie.Poster !== 'N/A' ? movie.Poster : 'https://via.placeholder.com/300x450?text=No+Poster' %>" referrerpolicy="no-referrer"/>
								</a>
								<br/>
								<strong><a href="/movie/<%= movie.imdbID %>"><%= movie.Title %></a></strong>
								(<%= movie.Year %>)
							</div>
						<% }) %>
					<% } else { %>
						<p>No movies to display.</p>
					<% } %>
				</div>
			</div>
		</div>
	</body>
</html>
