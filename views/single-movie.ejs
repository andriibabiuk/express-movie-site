<!DOCTYPE html>
<html>
	<head>
		<title>Movie Details</title>
		<% include head %>
	</head>
	<body>
		<% include navbar %>

		<div class="container mt-4">
			<div class="row">
				<% if (parsedData && parsedData.Response === 'True') { %>
					<div class="col-md-4 col-sm-12">
						<img src="<%= parsedData.Poster !== 'N/A' ? parsedData.Poster : 'https://via.placeholder.com/300x450?text=No+Poster' %>" referrerpolicy="no-referrer" class="img-responsive single-movie-poster"/>
					</div>
					<div class="col-md-8 col-sm-12">
						<h2 class="single-movie-title"><%= parsedData.Title %> (<%= parsedData.Year %>)</h2>
						<hr>
						<div class="movie-details">
							<p><strong>Director:</strong> <%= parsedData.Director %></p>
							<p><strong>Actors:</strong> <%= parsedData.Actors %></p>
							<p><strong>Genre:</strong> <%= parsedData.Genre %></p>
							<p><strong>IMDb Rating:</strong> ⭐ <%= parsedData.imdbRating %></p>
						</div>
						<br/>
						<p class="overview-header">Plot Summary</p>
						<p class="single-movie-overview"><%= parsedData.Plot %></p>
						<br/>
						<a href="/" class="btn btn-primary mt-3">Back to Movies</a>
						<button type="button" class="btn btn-info mt-3" data-toggle="modal" data-target="#moreInfoModal">More Info</button>

						<!-- Modal -->
						<div class="modal fade" id="moreInfoModal" tabindex="-1" role="dialog" aria-labelledby="moreInfoModalLabel">
							<div class="modal-dialog" role="document">
								<div class="modal-content">
									<div class="modal-header">
										<button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
										<h4 class="modal-title" id="moreInfoModalLabel">More Info - <%= parsedData.Title %></h4>
									</div>
									<div class="modal-body">
										<p><strong>IMDb Link:</strong> <a href="https://www.imdb.com/title/<%= parsedData.imdbID %>" target="_blank">View on IMDb</a></p>
										<p><strong>Release Date:</strong> <%= parsedData.Released && parsedData.Released !== 'N/A' ? parsedData.Released : 'Not Available' %></p>
										<p><strong>Revenue:</strong> <%= parsedData.BoxOffice && parsedData.BoxOffice !== 'N/A' ? parsedData.BoxOffice : 'Not Available' %></p>
										<p><strong>Production Companies:</strong> <%= parsedData.Production && parsedData.Production !== 'N/A' ? parsedData.Production : 'Not Available' %></p>
									</div>
									<div class="modal-footer">
										<button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
									</div>
								</div>
							</div>
						</div>
					</div>
				<% } else { %>
					<h2>Movie not found.</h2>
					<a href="/" class="btn btn-primary mt-3">Back to Movies</a>
				<% } %>
			</div>
		</div>
	</body>
</html>